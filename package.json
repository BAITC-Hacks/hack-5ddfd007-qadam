{
  "name": "qadam-contractor-matching",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx --env-file-if-exists=.env.local scripts/validate-dataset.ts",
    "test:e2e": "playwright test",
    "verify:ai": "tsx --env-file-if-exists=.env.local scripts/verify-ai.ts"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
